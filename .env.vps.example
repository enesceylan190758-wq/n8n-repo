# VPS production — .env olarak kopyalayın: cp .env.vps.example .env

# Genel
N8N_PUBLIC_HOST=api.nefalix.com
EVOLUTION_PUBLIC_HOST=evo.nefalix.com
V2_SITE_HOST=v2.nefalix.com
ACME_EMAIL=enes.ceylan190758@gmail.com

# n8n
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_STRONG
N8N_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# n8n-mcp (opsiyonel — sunucuda MCP gerekmezse MCP_PORT boş bırakılabilir)
MCP_AUTH_TOKEN=CHANGE_ME_openssl_rand_hex_32
MCP_PORT=3000

N8N_API_KEY=

# Supabase — n8n container içinden host.docker.internal (127.0.0.1 değil)
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Evolution WhatsApp
EVOLUTION_PORT=8080
EVOLUTION_SERVER_URL=https://evo.nefalix.com
EVOLUTION_API_KEY=CHANGE_ME_openssl_rand_hex_16
EVOLUTION_POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_12

# Estesoft Stella API (Medident) — randevu poll + webhook adapter
ESTESOFT_API_USERNAME=
ESTESOFT_API_KEY=
ESTESOFT_API_PASSWORD=
ESTESOFT_TENANT_ID=
ESTESOFT_STELLA_API_BASE=https://medidentistanbul.stellamedi.com

# WhatsApp ban önleme (tüm gönderimler wf-00 gateway)
WHATSAPP_SEND_ENABLED=false
WHATSAPP_MIN_INTERVAL_SEC=45
WHATSAPP_MAX_PER_HOUR=20
WHATSAPP_MAX_BURST_5MIN=3
ESTESOFT_POLL_MAX_PER_RUN=1
ESTESOFT_POLL_HOURS=24
N8N_URL=http://127.0.0.1:5678
N8N_EMAIL=enkahealthist@gmail.com
N8N_PASSWORD=

# OpenAI — AI workflow'lar
OPENAI_API_KEY=

# Manus AI (opsiyonel — SOCIAL_IMAGE_PROVIDER=manus ile görsel agent)
MANUS_API_KEY=

# Google Places API (New) — tüm klinik Google yorum senkronu
GOOGLE_PLACES_API_KEY=

# PayTR Checkout (opsiyonel - public pricing page Vercel/API tarafı)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=0
PAYTR_DEBUG=1
PAYTR_OK_URL=https://nefalix.com/fiyatlar?payment=success
PAYTR_FAIL_URL=https://nefalix.com/fiyatlar?payment=failed

# Şikayetvar sync (wf-14) — VPS IP 403 alırsa jina proxy otomatik devreye girer
# SIKAYETVAR_USE_JINA=1
# SIKAYETVAR_REQUEST_DELAY_SEC=2

# Günlük blog (cron 09:00 TR)
BLOG_SMTP_HOST=smtp.hostinger.com
BLOG_SMTP_PORT=465
BLOG_SMTP_USER=info@nefalix.com
BLOG_SMTP_FROM=info@nefalix.com
BLOG_SMTP_PASSWORD=
BLOG_NOTIFY_TO=enes.ceylan190758@gmail.com,akadirysr@gmail.com
# Saha CRM randevu maili (yoksa BLOG_NOTIFY_TO kullanılır)
CRM_NOTIFY_TO=enes.ceylan190758@gmail.com,akadirysr@gmail.com

# Günlük sosyal medya (cron 09:30 TR) — Meta + LinkedIn tokenları doldurun
SOCIAL_DRIVE_FOLDER_ID=
SOCIAL_IMAGE_PROVIDER=openai
SOCIAL_TEXT_PROVIDER=openai
SOCIAL_OPENAI_TEXT_MODEL=gpt-5
SOCIAL_OPENAI_TEXT_FALLBACKS=gpt-4.1,gpt-4o,gpt-4o-mini
SOCIAL_GPT5_MAX_TOKENS=16000
SOCIAL_OPENAI_IMAGE_MODEL=gpt-image-2
SOCIAL_OPENAI_IMAGE_FALLBACKS=gpt-image-1.5,gpt-image-1
SOCIAL_OPENAI_IMAGE_QUALITY=high
SOCIAL_OPENAI_IMAGE_SIZE=1024x1024
SOCIAL_LOGO_PATH=assets/brand/nefalix-logo.png
SOCIAL_LOGO_SIZE=96
SOCIAL_IMAGE_PROVIDER=openai
SOCIAL_NOTIFY_TO=enes.ceylan190758@gmail.com,akadirysr@gmail.com
SOCIAL_APPROVE_BASE_URL=https://nefalix.com/api/social
SOCIAL_PUBLISH_WEBHOOK_URL=https://api.nefalix.com/internal/social/publish
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
NEFALIX_INTERNAL_KEY=
