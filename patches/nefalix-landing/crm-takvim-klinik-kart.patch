+function klinikGuncelle(cid){
+  if(!canEditKlinik()){ toast('Düzenleme yetkiniz yok.'); return; }
+  const c = S.clinics.find(x=>x.id===cid); if(!c) return;
+  const ad = (document.getElementById('kk_ad')?.value||'').trim();
+  if(!ad){ toast('Klinik adı zorunlu.'); return; }
+  const semt = (document.getElementById('kk_semt')?.value||'').trim();
+  c.ad = ad;
+  c.brans = (document.getElementById('kk_br')?.value||'').trim();
+  c.yetkili = (document.getElementById('kk_yet')?.value||'').trim();
+  c.unvan = (document.getElementById('kk_unv')?.value||'').trim();
+  c.tel = (document.getElementById('kk_tel')?.value||'').trim();
+  c.email = (document.getElementById('kk_em')?.value||'').trim();
+  c.web = (document.getElementById('kk_web')?.value||'').trim();
+  c.hekimSayisi = (document.getElementById('kk_hek')?.value||'').trim();
+  c.sehir = (document.getElementById('kk_seh')?.value||'').trim();
+  c.semt = semt; c.ilce = semt;
+  c.bolge = (document.getElementById('kk_bol')?.value||'').trim();
+  c.adres = (document.getElementById('kk_adr')?.value||'').trim();
+  c.vergi = (document.getElementById('kk_verg')?.value||'').trim();
+  c.kaynak = (document.getElementById('kk_kay')?.value||'').trim();
+  c.olcek = (document.getElementById('kk_olc')?.value||'').trim();
+  c.uluslararasi = (document.getElementById('kk_ul')?.value||'').trim();
+  c.skor = Number(document.getElementById('kk_sk')?.value)||c.skor||3;
+  c.sorumlu = document.getElementById('kk_sr')?.value||'';
+  // hatirlatma / segment dokunulmaz
+  kaydet(); toast('Klinik kartı güncellendi.'); klinikAc(cid,'detay'); ciz();
+}
