{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.nefalix.com" }],
      "destination": "https://nefalix.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nefalixai.com" }],
      "destination": "https://nefalix.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.nefalixai.com" }],
      "destination": "https://nefalix.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/k/enes", "destination": "/k/enes.html" },
    { "source": "/k/abdulkadir", "destination": "/k/abdulkadir.html" },
    { "source": "/geo-sitemap.xml", "destination": "/api/geo-sitemap" }
  ],
  "headers": [
    {
      "source": "/k/(.*).vcf",
      "headers": [
        { "key": "Content-Type", "value": "text/vcard; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    }
  ]
}
